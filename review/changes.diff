+            'raw_ocr_texts': raw_ocr, 'ocr_texts': ocr_texts,
+            'mapped_components': mapped, 'layout': layout,
+            'generated_code': generate_react_code(layout), 'warnings': warnings,
+            'duration_seconds': round(time.perf_counter()-started, 2)}
 
 
